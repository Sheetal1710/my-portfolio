# GEMINI_API_KEY: Optional/Default for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AZURE_OPENAI_API_KEY: Optional - For Azure OpenAI API integration
AZURE_OPENAI_API_KEY="your-azure-api-key"
# AZURE_OPENAI_ENDPOINT: E.g., https://your-resource-name.openai.azure.com
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com"
# AZURE_OPENAI_DEPLOYMENT: E.g., gpt-4o or your fine-tuned deployment
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
# AZURE_OPENAI_API_VERSION: Default 2024-08-01-preview
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# NVIDIA_API_KEY: Optional - For NVIDIA Nemotron LLM & Nemotron Embeddings (RAG)
NVIDIA_API_KEY="nvapi-your-key-here"
